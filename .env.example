NODE_ENV=development
PORT=3000
PUBLIC_BASE_URL=http://localhost:3000
ADMIN_PASSWORD=
DATABASE_PATH=./data/daybreaker.sqlite

# Configurá ambos únicamente en el backend de Vercel para habilitar D1.
# D1_PROXY_URL debe ser la URL HTTPS del Worker privado de Cloudflare.
D1_PROXY_URL=https://daybreaker-d1-dev.franco11dev.workers.dev
D1_PROXY_SECRET=
D1_PROXY_VERIFIED=false

# Contacto comercial autorizado para publicar.
CONTACT_EMAIL=
WHATSAPP_PHONE=

# Completar cuando DAYBREAKER entregue los datos de su cuenta bancaria.
BANK_ACCOUNT_HOLDER=
BANK_NAME=
BANK_CBU=
BANK_ALIAS=
BANK_CUIT=

# Mercado Pago se habilita solo con credenciales de la cuenta de DAYBREAKER.
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
