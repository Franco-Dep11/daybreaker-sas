{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.js": {
      "includeFiles": "public/**"
    }
  },
  "rewrites": [
    {
      "source": "/",
      "destination": "/api/index?__path=/"
    },
    {
      "source": "/api/:path*",
      "missing": [
        {
          "type": "query",
          "key": "__path"
        }
      ],
      "destination": "/api/index?__path=/api/:path*"
    },
    {
      "source": "/:path*",
      "missing": [
        {
          "type": "query",
          "key": "__path"
        }
      ],
      "destination": "/api/index?__path=/:path*"
    }
  ]
}
